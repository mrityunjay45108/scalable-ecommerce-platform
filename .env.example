# =============================================================================
# NOVASTORE E-COMMERCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# 2. MANAGED NEON / POSTGRESQL DATABASE
# -----------------------------------------------------------------------------
# Runtime Pooled Connection (Used by Prisma Client Query Engine with PgBouncer):
# Format: postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct Unpooled Session Connection (Used by Prisma CLI for Migrations / DDL locks):
# Format: postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# 3. REDIS IN-MEMORY CACHE & SESSION STORE (Upstash / ElastiCache / Redis)
# -----------------------------------------------------------------------------
REDIS_URL="rediss://default:password@sample-redis-host.upstash.io:6379"
UPSTASH_REDIS_REST_URL="https://sample-redis-host.upstash.io"
UPSTASH_REDIS_REST_TOKEN="sample_upstash_rest_token_placeholder"

# -----------------------------------------------------------------------------
# 4. JWT AUTHENTICATION & TOKEN ROTATION
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_min_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_min_32_characters
JWT_REFRESH_EXPIRATION=7d

# -----------------------------------------------------------------------------
# 5. PAYMENT GATEWAY INTEGRATIONS
# -----------------------------------------------------------------------------
# Razorpay (Primary)
RAZORPAY_KEY_ID=rzp_test_sampleKeyId
RAZORPAY_KEY_SECRET=sampleRazorpaySecretKey
RAZORPAY_WEBHOOK_SECRET=sampleRazorpayWebhookSecret

# Stripe (Secondary / International)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# -----------------------------------------------------------------------------
# 6. CLOUDINARY MEDIA ASSET STORAGE
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL DISPATCH (SMTP / Resend / Amazon SES)
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NovaStore Support <noreply@novastore.com>"

# -----------------------------------------------------------------------------
# 8. FRONTEND PUBLIC ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="NovaStore"

# Firebase Client SDK Credentials (Web Auth / Social Login)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key_here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:sampleappid"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-SAMPLEID"

# -----------------------------------------------------------------------------
# 9. SHIPPING & LOGISTICS COURIER INTEGRATION
# -----------------------------------------------------------------------------
SHIPPING_PROVIDER=STANDARD_EXPRESS
SHIPPING_API_KEY=your_shipping_api_key_placeholder
SHIPPING_API_SECRET=your_shipping_api_secret_placeholder
SHIPPING_WEBHOOK_SECRET=your_shipping_webhook_secret_placeholder
SHIPPING_TIMEOUT_MS=10000

# Shiprocket Courier Integration (Set SHIPPING_PROVIDER=SHIPROCKET to activate)
SHIPROCKET_EMAIL="merchant@example.com"
SHIPROCKET_PASSWORD="your_shiprocket_account_password"
SHIPROCKET_BASE_URL="https://apiv2.shiprocket.in/v1/external"
SHIPROCKET_WEBHOOK_SECRET="your_shiprocket_webhook_secret_key"
SHIPROCKET_PICKUP_LOCATION="Primary"


# -----------------------------------------------------------------------------
# 10. RETURNS & REVERSE LOGISTICS POLICY
# -----------------------------------------------------------------------------
RETURN_WINDOW_DAYS=14

