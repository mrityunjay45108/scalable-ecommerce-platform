{
  "extends": "@ecommerce/tsconfig/nest.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@ecommerce/types": ["../../packages/types/src"],
      "@ecommerce/types/*": ["../../packages/types/src/*"],
      "@ecommerce/config": ["../../packages/config/src"],
      "@ecommerce/config/*": ["../../packages/config/src/*"],
      "@ecommerce/database": ["../../packages/database/src"],
      "@ecommerce/database/*": ["../../packages/database/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
