{
  "name": "@ecommerce/config",
  "version": "1.0.0",
  "private": true,
  "description": "Shared constants and configuration for NovaStore Monorepo",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "echo '@ecommerce/config lint clean'"
  },
  "devDependencies": {
    "@ecommerce/tsconfig": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
