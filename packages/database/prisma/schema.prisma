datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
  MODERATOR
  SELLER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  COD
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

// ==========================================
// AUTH & USER MANAGEMENT
// ==========================================

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  avatarUrl        String?
  role             UserRole       @default(CUSTOMER)
  roleId           String?
  roleModel        Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive                Boolean        @default(true)
  isEmailVerified         Boolean        @default(false)
  notificationPreferences Json?          @default("{\"email\":true,\"orderUpdates\":true,\"promotions\":false}")
  deletedAt               DateTime?
  
  // Relations
  addresses        Address[]
  orders           Order[]
  reviews          Review[]
  cart             Cart?
  wishlist         Wishlist?
  refreshTokens    RefreshToken[]
  couponUsages     CouponUsage[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([email])
  @@index([role])
  @@index([roleId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdAt])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique // e.g. "CUSTOMER", "ADMIN", "MODERATOR", "SELLER"
  description String?
  permissions Permission[] @relation("RolePermissions")
  users       User[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
}

model Permission {
  id          String   @id @default(uuid())
  slug        String   @unique // e.g. "products:create", "orders:manage", "users:read"
  name        String
  description String?
  roles       Role[]   @relation("RolePermissions")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked  Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  street        String
  city          String
  state         String
  postalCode    String
  country       String    @default("US")
  isDefault     Boolean   @default(false)
  orders        Order[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

// ==========================================
// CATALOG & PRODUCTS
// ==========================================

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  deletedAt   DateTime?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
  @@index([deletedAt])
}

model Product {
  id             String           @id @default(uuid())
  title          String
  slug           String           @unique
  description    String           @db.Text
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  basePrice      Decimal          @db.Decimal(10, 2)
  comparePrice   Decimal?         @db.Decimal(10, 2)
  isPublished    Boolean          @default(true)
  isFeatured     Boolean          @default(false)
  avgRating      Decimal          @default(0.0) @db.Decimal(3, 2)
  reviewCount    Int              @default(0)
  deletedAt      DateTime?

  // Relations
  variants       ProductVariant[]
  images         ProductImage[]
  reviews        Review[]
  wishlistItems  WishlistItem[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([deletedAt])
  @@index([basePrice])
  @@index([avgRating])
  @@index([reviewCount])
  @@index([categoryId, isPublished, deletedAt])
  @@index([isFeatured, isPublished, createdAt])
  @@index([isPublished, deletedAt, basePrice])
  @@index([isPublished, deletedAt, avgRating])
  @@index([isPublished, deletedAt, createdAt])
  @@index([createdAt])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  publicId   String   // Cloudinary public ID
  altText    String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)

  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([productId, isPrimary])
  @@index([productId, sortOrder])
}

model ProductVariant {
  id             String         @id @default(uuid())
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String         @unique
  title          String         // e.g. "Red / XL" or "Midnight Black / 128GB"
  price          Decimal        @db.Decimal(10, 2)
  stockQuantity  Int            @default(0)
  reservedStock  Int            @default(0)
  attributes     Json           // e.g. {"color": "Red", "size": "XL"}
  deletedAt      DateTime?
  
  // Relations
  inventory      Inventory?
  cartItems      CartItem[]
  orderItems     OrderItem[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([deletedAt])
}

model Inventory {
  id             String         @id @default(uuid())
  variantId      String         @unique
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity       Int            @default(0)
  reserved       Int            @default(0)
  lowStockAlert  Int            @default(10)
  location       String?        @default("MAIN_WAREHOUSE")
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([variantId])
  @@index([quantity])
  @@index([lowStockAlert])
}

enum InventoryLogType {
  RESERVATION
  RELEASE
  COMMIT
  RESTOCK
  ADJUSTMENT
  RETURN
}

model InventoryLog {
  id               String           @id @default(uuid())
  variantId        String
  previousStock    Int
  newStock         Int
  change           Int
  type             InventoryLogType
  reason           String?
  orderNumber      String?
  adminUserId      String?
  createdAt        DateTime         @default(now())

  @@index([variantId])
  @@index([type])
  @@index([orderNumber])
  @@index([createdAt])
}

// ==========================================
// CART & WISHLIST
// ==========================================

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id         String         @id @default(uuid())
  cartId     String
  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int            @default(1)

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

// ==========================================
// ORDERS & PAYMENTS
// ==========================================

model Order {
  id              String         @id @default(uuid())
  orderNumber     String         @unique // e.g. ORD-2026-XXXXX
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  shippingAddress Address        @relation(fields: [addressId], references: [id], onDelete: Restrict)
  addressId       String
  
  subtotal        Decimal        @db.Decimal(10, 2)
  tax             Decimal        @db.Decimal(10, 2)
  shippingCost    Decimal        @db.Decimal(10, 2)
  discountAmount  Decimal        @default(0.0) @db.Decimal(10, 2)
  totalAmount     Decimal        @db.Decimal(10, 2)
  
  couponId        String?
  coupon          Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  
  status          OrderStatus    @default(PENDING_PAYMENT)
  payment         Payment?
  items           OrderItem[]
  trackingNumber  String?
  notes           String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([addressId])
  @@index([couponId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id           String         @id @default(uuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity     Int
  unitPrice    Decimal        @db.Decimal(10, 2)
  totalPrice   Decimal        @db.Decimal(10, 2)
  productTitle String?
  variantTitle String?
  sku          String?
  imageUrl     String?

  createdAt    DateTime       @default(now())

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id              String          @id @default(uuid())
  orderId         String          @unique
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        PaymentProvider
  transactionId   String?         @unique
  paymentIntentId String?
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("USD")
  status          PaymentStatus   @default(PENDING)
  rawResponse     Json?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([orderId])
  @@index([transactionId])
  @@index([status])
}

// ==========================================
// MARKETING & REVIEWS
// ==========================================

model Coupon {
  id                    String        @id @default(uuid())
  code                  String        @unique
  discountType          DiscountType
  discountValue         Decimal       @db.Decimal(10, 2)
  minOrderValue         Decimal?      @db.Decimal(10, 2)
  maxDiscount           Decimal?      @db.Decimal(10, 2)
  usageLimit            Int?
  perUserLimit          Int?          @default(1)
  usedCount             Int           @default(0)
  applicableCategoryIds String[]      @default([])
  applicableProductIds  String[]      @default([])
  startDate             DateTime
  endDate               DateTime
  isActive              Boolean       @default(true)
  deletedAt             DateTime?

  orders                Order[]
  usages                CouponUsage[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
  @@index([startDate, endDate])
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  usedAt    DateTime @default(now())

  @@unique([couponId, userId, orderId])
  @@index([couponId])
  @@index([userId])
  @@index([orderId])
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int      // 1 to 5
  title              String?
  comment            String   @db.Text
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(true)
  isHidden           Boolean  @default(false)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([isApproved])
  @@index([isHidden])
  @@index([productId, isApproved, isHidden, createdAt])
}

enum NotificationType {
  WELCOME
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ORDER_CREATED
  PAYMENT_SUCCESSFUL
  PAYMENT_FAILED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PROMOTION
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(ORDER_CREATED)
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?

  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, type])
  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. "PRODUCT_UPDATED", "ORDER_STATUS_CHANGED"
  entity     String   // e.g. "Order", "Product"
  entityId   String
  details    Json?
  ipAddress  String?

  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([entity, entityId, createdAt])
}
